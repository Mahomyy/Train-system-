#lang racket

(require racket/tcp
         racket/serialize)

(provide send-request-to-infrabel)

(define (send-request-to-server host port request)
  (with-handlers ([exn:fail:network? (lambda (exn) (printf "Network error: ~a\n" exn) 'error)]
                  [exn:fail? (lambda (exn) (printf "Error: ~a\n" exn) 'error)])
    (define-values (in out) (tcp-connect host port))
    (serialize request out)
    (flush-output out)
    (define response (deserialize in))
    (close-input-port in)
    (close-output-port out)
    response))

(define (send-request-to-infrabel command args)
  (send-request-to-server "localhost" 4000 (cons command args)))
